{
  "name": "@aiops/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts quiet-grid-layout.spec.ts",
    "test:screenshots": "playwright test --config playwright.config.ts screenshots.spec.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@antv/g6": "^5.0.0",
    "axios": "^1.7.0",
    "highlight.js": "^11.11.1",
    "marked": "^17.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.54.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "3.0.9"
  }
}
